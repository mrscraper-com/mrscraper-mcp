PORT=8000
HOST=0.0.0.0
TRANSPORT=http

# stdio or server-side fallback (never exposed in tool schemas)
MRSCRAPER_API_TOKEN=

# optional: SERP sync bearer if different from MRSCRAPER_API_TOKEN
MRSCRAPER_GOOGLE_SERP_TOKEN=

# set to 0 only for local HTTP debugging without Bearer on /mcp and /chatgpt
MRSCRAPER_HTTP_AUTH=1
