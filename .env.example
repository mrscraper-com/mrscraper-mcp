PORT=8000
HOST=127.0.0.1
TRANSPORT=http

# Preferred stdio credential (never used by HTTP tool calls or tool schemas)
MRSCRAPER_API_KEY=

# Alternate stdio credential name
MRSCRAPER_API_TOKEN=

# Keep enabled for HTTP deployments. Set to 0 only for isolated protocol
# debugging; HTTP tool calls must still provide their own credential header.
MRSCRAPER_HTTP_AUTH=1

# Comma-separated browser origins allowed to send Origin-bearing MCP requests.
# Service-to-service MCP clients normally omit Origin.
MRSCRAPER_ALLOWED_ORIGINS=

# Optional development/test endpoint overrides (same names as @mrscraper/cli)
# MRSCRAPER_API_BASE_URL=https://api.app.mrscraper.com/api/v1
# MRSCRAPER_FETCH_BASE_URL=https://api.mrscraper.com
# MRSCRAPER_SYNC_BASE_URL=https://sync.scraper.mrscraper.com
