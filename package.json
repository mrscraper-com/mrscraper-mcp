{
  "name": "@mrscraper/mcp",
  "version": "0.1.0",
  "description": "MrScraper MCP server for web fetching, extraction, Google SERPs, saved scraper reruns, results, and account status.",
  "license": "MIT",
  "author": "MrScraper",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrscraper-com/mrscraper-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/mrscraper-com/mrscraper-mcp/issues"
  },
  "homepage": "https://mrscraper.com",
  "keywords": [
    "mrscraper",
    "mcp",
    "model-context-protocol",
    "web-scraping",
    "data-extraction"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "mrscraper-mcp": "./dist/bin.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "clean": "node --eval \"import('node:fs').then(({ rmSync }) => rmSync('dist', { recursive: true, force: true }))\"",
    "build:widgets": "tsx scripts/build-widgets.ts",
    "preview:widgets": "tsx scripts/preview-widgets.ts",
    "build": "npm run clean && npm run build:widgets && tsc -p tsconfig.build.json",
    "dev": "tsx src/bin.ts",
    "start": "node dist/bin.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsx scripts/test-e2e.ts",
    "test:mcp": "tsx scripts/test-mcp.ts",
    "test:oauth": "tsx scripts/test-oauth.ts",
    "test:serp": "tsx scripts/test-serp.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "jose": "^6.2.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/express": "5.0.6",
    "@types/node": "26.2.0",
    "esbuild": "^0.27.7",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
